# ============================================
# ChatJimmy API Server Configuration
# ============================================

# Required: API key for authenticating client requests
# Generate a strong random key for production use
API_KEY=your-secret-api-key

# ============================================
# ChatJimmy API Settings
# ============================================

# Base URL for chatjimmy.ai API (optional, defaults to https://chatjimmy.ai)
CHATJIMMY_BASE_URL=https://chatjimmy.ai

# Request timeout in seconds (optional, defaults to 30)
CHATJIMMY_TIMEOUT=30

# ============================================
# Experimental Features (Use with caution)
# ============================================

# Enable Tool Use / Function Calling via prompt engineering
# WARNING: This is experimental and uses prompt engineering. Results may not be reliable.
# Default: false
ENABLE_TOOLS=false

# Enable JSON Mode / Structured Outputs via prompt engineering
# WARNING: This is experimental and output may not be valid JSON.
# Default: false
ENABLE_JSON_MODE=false

# ============================================
# Server Settings
# ============================================

# Port to run the server on (optional, defaults to 8000)
PORT=8000

# Host to bind the server to (optional, defaults to 0.0.0.0)
HOST=0.0.0.0

# Logging level: debug, info, warning, error (optional, defaults to info)
LOG_LEVEL=info

# ============================================
# CORS Settings
# ============================================

# Comma-separated list of allowed CORS origins (optional, defaults to *)
# Use "*" to allow all origins (not recommended for production)
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=*

# ============================================
# Proxy Settings (Optional)
# ============================================

# HTTP proxy URL (uncomment if needed)
# HTTP_PROXY=http://proxy.example.com:8080

# HTTPS proxy URL (uncomment if needed)
# HTTPS_PROXY=http://proxy.example.com:8080
